    "routing_diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["scalar_residual", "vector_covariance", "authority"],
      "properties": {
        "scalar_residual": {"const": "0"},
        "vector_covariance": {"const": "PASS"},
        "authority": {"const": "SUPPORTING_ONLY_P08_REMAINS_DEDICATED_ROUTING_GATE"}
      }
    },
    "uv_ir_classification": {
      "type": "object", "additionalProperties": false,
      "required": ["uv_pole", "ir_pole", "scaleless", "rstar_required"],
      "properties": {
        "uv_pole": {"const": true},
        "ir_pole": {"const": false},
        "scaleless": {"const": false},
        "rstar_required": {"const": false}
      }
    },
    "verdict": {"const": "PASS"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
